# ==========================================
# LEVEL UP DZ - ENVIRONMENT VARIABLES TEMPLATE
# ==========================================
# Copy this file to .env before starting the development server:
# cp .env.example .env

# Database Connection (SQLite locally, PostgreSQL in Production)
# PostgreSQL (Supabase) : valeurs dans le bouton "Connect" du tableau de bord
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres"

# NextAuth Authentication Security
NEXTAUTH_SECRET="development-super-secret-key-change-in-prod"
NEXTAUTH_URL="http://localhost:3000"

# Resend Email Service (Account Verification, 2FA OTP, Password Reset)
# Note: In local dev, OTP codes will also be printed directly in your terminal console!
RESEND_API_KEY=""

# Chargily Pay V2 (Algerian EDAHABIA & CIB Online Card Payments)
# Set to "test" for local development. If left default, the app runs in simulation mode.
CHARGILY_MODE="test"
CHARGILY_SECRET_KEY="your_chargily_secret_key_here"

# Google OAuth (Optional)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Cloud Video & Object Storage (Phase: Production Migration)
# Stockage des images (Supabase Storage)
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_secret_key_here"
# VIDEO_PROVIDER_API_KEY=""
